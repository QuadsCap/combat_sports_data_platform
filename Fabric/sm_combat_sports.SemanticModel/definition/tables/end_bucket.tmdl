table end_bucket

	column bucket
		summarizeBy: none
		isNameInferred
		sourceColumn: [bucket]
		sortByColumn: sort

	column sort
		formatString: 0
		summarizeBy: none
		isNameInferred
		isHidden
		sourceColumn: [sort]

	partition end_bucket = calculated
		mode: import
		source =
				DATATABLE (
					"bucket", STRING, "sort", INTEGER,
					{
						{ "Round 1", 1 },
						{ "Round 2", 2 },
						{ "Round 3", 3 },
						{ "Round 4–5", 4 },
						{ "Decision", 5 }
					}
				)

