table dim_fight
	lineageTag: eb03fe73-942b-439d-b139-e9c30bf24dd2
	sourceLineageTag: [dbo].[dim_fight]

	measure Finish_Rate =
			
			DIVIDE (
			    CALCULATE ( DISTINCTCOUNT ( fact_round[fight_key] ), dim_fight[method] IN { "KO/TKO", "Submission" } ),
			    DISTINCTCOUNT ( fact_round[fight_key] )
			)
		formatString: 0%;-0%;0%
		lineageTag: 06f75c21-6004-4efa-8e65-44295b59f189

		changedProperty = Name

		changedProperty = FormatString

		changedProperty = IsHidden

	measure Fights =
			
			COUNTROWS ( dim_fight )
		formatString: 0
		lineageTag: 8f3cfa5d-32e0-4e40-bb52-641214891794

		changedProperty = Name

		changedProperty = IsHidden

	measure Finishes =
			
			CALCULATE (
			    [Fights],
			    dim_fight[method] IN { "KO/TKO", "Submission" }
			)
		formatString: 0
		lineageTag: 6c0324f9-117e-4cf7-bcad-d91a0f9f46bd

		changedProperty = Name

		changedProperty = IsHidden

