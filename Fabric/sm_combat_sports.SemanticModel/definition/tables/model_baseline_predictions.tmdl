table model_baseline_predictions
	lineageTag: 6abab216-e1a1-49d3-834b-c108c043cdec
	sourceLineageTag: [dbo].[model_baseline_predictions]

	measure 'Fight Label' =
			
			VAR a = LOOKUPVALUE ( dim_fighter[full_name], dim_fighter[fighter_key],
			                      SELECTEDVALUE ( model_baseline_predictions[a_fighter_key] ) )
			VAR b = LOOKUPVALUE ( dim_fighter[full_name], dim_fighter[fighter_key],
			                      SELECTEDVALUE ( model_baseline_predictions[b_fighter_key] ) )
			RETURN a & " vs " & b
		lineageTag: 38ea7117-7676-4d5b-b685-93566fd371bf

		changedProperty = Name

	measure 'Wrong Pick Confidence' =
			
			VAR p   = SELECTEDVALUE ( model_baseline_predictions[p_a_win] )
			VAR won = SELECTEDVALUE ( model_baseline_predictions[a_won] )
			VAR pickedA = p > 0.5
			RETURN
			    IF ( pickedA <> ( won = 1 ), MAX ( p, 1 - p ) )
		lineageTag: a37bc7a6-2ac4-4ab5-95fc-b98971858585

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

