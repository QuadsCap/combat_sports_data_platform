model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["DirectLake - gold_layer"]

annotation PBI_ProTooling = ["DirectLakeOnOneLakeInWeb","WebModelingEdit","DaxQueryView_Desktop"]

ref table dim_date
ref table dim_event
ref table dim_fight
ref table dim_fighter
ref table fact_round
ref table model_baseline_metrics
ref table model_baseline_predictions
ref table age_band
ref table model_baseline_calibration

